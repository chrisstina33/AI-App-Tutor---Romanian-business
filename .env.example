# Local web app uses the deployed Render API.
EXPO_PUBLIC_API_BASE_URL=https://ai-app-tutor-romanian-business.onrender.com

# Configure this on the Render API service to allow local browser testing and the deployed frontend.
CORS_ALLOWED_ORIGINS=http://localhost:8081,https://ai-app-tutor-hsic26.vercel.app

# Server-only variables. Set them in the API host environment, never in EXPO_PUBLIC_*.
# Either use DATABASE_URL or provide all five DATABASE_* fields below.
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_SSL=false
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL_GPT5_MINI=openai/gpt-5-mini
OPENROUTER_MODEL_GPT5=openai/gpt-5
OPENROUTER_MODEL_GPT5_5=openai/gpt-5.5
APP_BASE_URL=https://ai-app-tutor-hsic26.vercel.app
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional public address used by the school/education-center inquiry form.
EXPO_PUBLIC_PARTNERSHIPS_EMAIL=
