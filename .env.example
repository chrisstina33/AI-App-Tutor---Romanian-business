# Local web app and API: run both with `pnpm dev`.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PACKAGER_PROXY_URL=http://localhost:8081

# Keep the OpenRouter key in your ignored local .env, or set it in Render's environment.
OPENROUTER_API_KEY=

# Render only: exact, comma-separated deployed frontend origins. Leave blank for local testing.
CORS_ALLOWED_ORIGINS=
